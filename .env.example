# ---------------------------------------------------------------------------
# HOOPERS SNEAKERS — environment template
# Copy to `.env.local` (never commit real values) and fill in from
# Supabase → Project Settings → API. See docs/SETUP.md for the full guide.
# ---------------------------------------------------------------------------

# Public project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose; RLS is the security boundary).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Service-role key — bypasses RLS. NEVER prefix with NEXT_PUBLIC_,
# never import into client components, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL used for metadata/sitemaps (e.g. https://hoopers.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
